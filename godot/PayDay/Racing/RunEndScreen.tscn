[gd_scene load_steps=2 format=3 uid="uid://runendscreen01"]

[ext_resource type="Script" path="res://PayDay/Racing/RunEndScreen.cs" id="1_runend"]

[node name="RunEndScreen" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_runend")

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(500, 400)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2

[node name="MoneyLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "Money earned: $0"

[node name="SeparatorLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "--- Parts Collected ---"

[node name="PartsContainer" type="VBoxContainer" parent="Panel/VBox"]
layout_mode = 2

[node name="ReturnHomeButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "Return Home"

[connection signal="pressed" from="Panel/VBox/ReturnHomeButton" to="." method="ReturnHomeButton_Pressed"]
